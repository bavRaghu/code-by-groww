# ============================================================
# Smart Market Watchlist – Backend environment variables
# ============================================================
#
# Copy this file to .env and fill in real values.
# Never commit .env to version control.
#
# ---------------------------------------------------------
# Application
# ---------------------------------------------------------
APP_NAME="Smart Market Watchlist"
APP_VERSION="0.1.0"
DEBUG=false

# ---------------------------------------------------------
# Database
# PostgreSQL connection string (asyncpg driver)
# Matches the Docker Compose defaults in the repo root.
# ---------------------------------------------------------
DATABASE_URL="postgresql+asyncpg://smw_user:smw_password@localhost:5432/smw_db"

# ---------------------------------------------------------
# CORS
# Comma-separated list of allowed frontend origins.
# ---------------------------------------------------------
CORS_ORIGINS='["http://localhost:5173"]'

# ---------------------------------------------------------
# (Future) External data providers – leave empty for now
# ---------------------------------------------------------
# TWELVE_DATA_API_KEY=
# MARKETAUX_API_KEY=
